# Ignore everything starting with dot, except specific files.
.*
!.editorconfig
!.gitignore
!.gitattributes
!.github
!.gitmodules

*.user
*.ncb
/build*
nbproject/
project/
doxygen/
*.a
*.o
CMakeCache.txt
CMakeFiles
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
*.so*
# GeneralsX @build Android port ANGLE experiment - prebuilt ANGLE .so's are
# a committed vendor artifact (see package-android-zh.sh), not a build
# output, so they're exempt from the blanket *.so* ignore above.
!Core/Libraries/Source/d3d8gles/angle-prebuilt/**/*.so
CPackConfig.cmake
CPackSourceConfig.cmake
*.spec
*.ncb
*.sdf
*.suo
*.sln
*.vcxproj*
*.vcproj
.cproject
.project
*~
!*.exe
*.lastbuildstate
*.unsuccessfulbuild
*.tlog
*.idb
*.cd
*.tmp
*.bak
thumbs.db
/CMakeUserPresets.json
/.cache
.clang-format
/Dependencies/MaxSDK/maxsdk
/tmp/

## AI assistant config (user-specific)
/.claude/
/CLAUDE.md

## IntelliJ, CLion, etc.
/.idea

# IntelliJ-style CMake bits
cmake-build-*/

## Ninja
.ninja_deps
.ninja_log
build.ninja

## Python
__pycache__/
*.pyc

## Build Logs (generated during development)
/logs/
GeneralsMD/logs/
Generals/logs/

# vcpkg artifacts (generated dependencies)
/vcpkg_installed/

# External reference repositories (large, don't commit)
# references/

# Release bundles
GeneralsX-macos-*.zip
GeneralsXZH-macos-*.zip
GeneralsX-linux-*.tar.gz
GeneralsXZH-linux-*.tar.gz

# flatpak build files (exclude staging/build dirs but track scripts and manifests)
.flatpak-builder/
flatpak/staging/
flatpak/*.flatpak

#tmp and log files on root folder
logs_*.zip
*.log
# iOS shell-app build products (XcodeGen regenerates the project from ios/project.yml)
ios/build/
ios/GeneralsXZH.xcodeproj/

# Android packaging staging dir (scripts/build/android/package-android-zh.sh):
# fetched fonts + default Turnip driver, re-derivable, not source.
android-staging/
# build-local-sandboxed.sh's own output APK -- a build product (GitHub LFS
# is disabled on this fork, so a ~40MB binary can't go into version control
# at all even if it were source), not something to commit.
/GeneralsXZH-android-local.apk

# ---------------------------------------------------------------------------
# BFME1 Mobile (ветка bfme): ресурсы игры EA НИКОГДА не попадают в git.
# Уже отслеживаемые файлы апстрима эти правила не затрагивают.
# ---------------------------------------------------------------------------
# .gitkeep нужен, чтобы держать пустые каталоги (правило ".*" выше их скрывает)
!.gitkeep

# Архивы и видео игры
*.big
*.BIG
*.Big
*.bik
*.BIK
*.vp6

# Локальные копии данных игры и входящие файлы
/gamedata/
/incoming/
**/BFME1/
**/bfme1-data/

# Выгрузки из данных EA (имена скриптов и т. п.): строит tools/datacheck из gamedata/, в git не идут
/docs/formats/data/bfme1_script_names_maps_big.tsv

# Модели W3D только в тестовых фикстурах (и в уже существующих каталогах апстрима)
*.w3d
*.W3D
!/tests/**/*.w3d
!/Core/Libraries/Source/WWVegas/WW3D2/RequiredAssets/*.w3d
!/Core/Tools/W3DView/Res/*.w3d

# Строки и локализация из игры
*.csf
*.CSF

# Конфиги сервисов с ключами (Firebase и т. п.)
google-services.json

# Сборки APK — в артефакты CI, не в git (история апстрима и так весит ~15 ГБ из-за apk/)
*.apk
*.aab

# BFME1 Mobile: ключи подписи и секреты никогда не попадают в git
*.keystore
*.jks
/secrets/
/out/
/logs/
*.apks
/cache/
.docker-data/
*.keystore.pass
keystore.pass

# QA: default --out of tools/replay-test / run_replay_tests.py (results, engine logs, scenario .rep)
tests/replay/out/
