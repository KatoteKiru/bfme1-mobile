# Runs heights_zh_dump built against the upstream tree (OLD) and against this tree (NEW) on the same
# input and requires byte-identical output (world heights, cliff flags; see src/ZhDump.cpp).
foreach(side OLD NEW)
    set(args --out ${WORK}/${side}.bin)
    if(MAPS_DIR)
        list(APPEND args --maps-dir ${MAPS_DIR})
    endif()
    execute_process(COMMAND ${${side}} ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    message(STATUS "${side}: ${out}${err}")
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${${side}} failed: ${rc}")
    endif()
endforeach()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${WORK}/OLD.bin ${WORK}/NEW.bin RESULT_VARIABLE diff)
if(NOT diff EQUAL 0)
    message(FATAL_ERROR "ZH world heights / cliff flags differ between the upstream and the E1-25 build")
endif()
file(SIZE ${WORK}/NEW.bin size)
message(STATUS "identical: ${size} bytes")
